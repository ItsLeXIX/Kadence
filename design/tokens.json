  "$meta": {
    "name": "Kadence design tokens",
    "version": "1.3.0",
    "phase": 2,
    "updated": "2026-10-07",
    "sourceOfTruth": "This file. Tokens.swift is generated from it and must never be hand-edited.",
    "swiftMapping": {
      "rule": "Dot path -> nested caseless enums, PascalCase per segment, camelCase leaf. color.surface.canvas -> Tokens.Color.Surface.canvas",
      "colorLeafType": "Color (SwiftUI). A leaf with light/dark keys generates a dynamic NSColor wrapped in Color.",
      "numericLeafType": "CGFloat",
      "durationLeafType": "Double (seconds)",
      "contract": "Matches the mapping documented in design/GAPS.md G-002 as written by the coding agent. This file was shaped to that contract rather than the other way round; see the answers to G-002 Q1-Q5 recorded there.",
      "integerLeaves": [
        "size.allDayMaxRows",
        "size.blockCascadeMaxSteps",
        "size.blockCascadeMaxVisible",
        "size.monthCellMaxVisibleRows",
        "typography.*.lineLimit",
        "size.popoverMaxRestRows"
      ],
      "integerLeavesNote": "Answers GAPS.md G-008. These leaves are counts, not dimensions, and must emit as Int rather than CGFloat. Explicit list rather than name-matching so nothing is guessed; * matches one path segment. typography.*.lineLimit == 0 means no limit."
    },
    "valueForms": {
      "appearancePair": "{ \"light\": \"#RRGGBB\" | \"#RRGGBBAA\", \"dark\": ... } -> one adaptive Color. Every colour in this file uses this form; there are no {\"system\": ...} or {\"material\": ...} leaves.",
      "platformName": "A sibling String leaf named <token>SystemName or <token>Material naming the platform value to prefer at runtime (e.g. surface.sidebarMaterial = \"sidebar\", interactive.accentSystemName = \"controlAccentColor\"). The appearancePair beside it is the literal fallback, and is what Reduce Transparency and the contrast checks use.",
      "primitive": "number -> CGFloat, string -> String, bool -> Bool, array of numbers/strings -> [CGFloat]/[String].",
      "namespace": "any other object -> a nested enum. No leaf is an array of objects.",
      "metadata": "any key starting with $ is skipped by codegen."
    },
    "colorSpace": "sRGB. Palette derived in OKLCH (C=0.16, C=0.012 for graphite) then gamut-clipped.",
    "contrastVerified": {
      "standard": "WCAG 2.1 AA, 4.5:1 for text",
      "measuredMinimums": {
